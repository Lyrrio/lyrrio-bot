# Copie ce fichier en .env puis remplace la valeur.
DISCORD_TOKEN=colle_le_token_du_bot_ici

# Optionnel : ID de ton serveur de test. Les commandes slash y apparaissent
# immédiatement. Sans cette ligne, elles sont synchronisées globalement.
TEST_GUILD_ID=

# Pièces gagnées par le vainqueur d'une partie (optionnel, défaut : 100).
WIN_REWARD=100
